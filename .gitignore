# --- Python ---
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.egg-info/
build/

# --- Environment / secrets ---
.env
.env.*
!.env.example

# --- Runtime (Role 2) ---
var/

# --- Datasets (Role 1): only manifests and READMEs are versioned ---
data/**
!data/
!data/**/
