# Copy to .env and adjust. Never commit .env. (Roadmap Section 9.6)

# ---------- Role 2: application ----------
SMQI_ENV=dev                                  # dev | test | demo
SMQI_DATABASE_URL=sqlite:///./var/smqi.db
SMQI_INTELLIGENCE_BACKEND=mock                # mock | hybrid | real  (demo requires real)
SMQI_CORS_ORIGINS=http://localhost:5173       # comma-separated
SMQI_API_KEY=                                 # empty = X-API-Key check disabled
SMQI_LOG_LEVEL=INFO
SMQI_LOG_FORMAT=json                          # json | console
SMQI_STAGE_PRESENTATION_MS=1500               # 1200-2000 (presentation speed, not process time)
SMQI_STAGE_CACHE_SIZE=5000
SMQI_RATE_LIMIT_PER_MIN=30

# ---------- Role 1: intelligence artifacts (read-only for the app) ----------
SMQI_MODEL_DIR=./models
SMQI_FUSION_MODEL_VERSION=active
SMQI_ANOMALY_MODEL_VERSION=active
SMQI_STAGE_STATS_VERSION=active
SMQI_CONSTRAINTS_PATH=./backend/app/domain/constraints.yaml
SMQI_FLEET_PATH=./backend/app/domain/fleet.yaml   # DB seed source (file authored by Role 1)
SMQI_RECOMMEND_TIME_BUDGET_S=5

# ---------- Role 1: offline training only ----------
SMQI_DATA_DIR=./data
SMQI_SEED=42
MLFLOW_TRACKING_URI=file:./mlruns

# ---------- Frontend (frontend/.env.local) ----------
# VITE_API_BASE_URL=http://localhost:8000/api/v1
